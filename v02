      lychee:{name:"Lychee Glow Tea",price:12000},
      bundle:{name:"Paket Mix 3 Cup",price:27000}
    };
    const cart = {};
    const money = n => new Intl.NumberFormat("id-ID",{style:"currency",currency:"IDR",maximumFractionDigits:0}).format(n);
    const modal = document.getElementById("cartModal");
    const toast = document.getElementById("toast");
    function showToast(message){
      toast.textContent=message;toast.classList.add("show");
      window.setTimeout(()=>toast.classList.remove("show"),2200);
    }
    function addItem(id){
      if(!catalog[id]) return;
      cart[id]=(cart[id]||0)+1;
      updateCart();showToast(catalog[id].name+" ditambahkan");
    }
    function updateCart(){
      const entries=Object.entries(cart).filter(([,qty])=>qty>0);
      document.getElementById("cartCount").textContent=entries.reduce((sum,[,qty])=>sum+qty,0);
      const list=document.getElementById("cartList");
      if(!entries.length){list.innerHTML='<div class="empty">Keranjang masih kosong.<br>Tambahkan menu untuk mencoba simulasi.</div>';}
      else{
        list.innerHTML=entries.map(([id,qty])=>`<div class="cart-row"><div><strong>${catalog[id].name}</strong><small>${money(catalog[id].price)} / item</small></div><div class="cart-controls"><button type="button" data-change="${id}" data-delta="-1" aria-label="Kurangi ${catalog[id].name}">−</button><strong>${qty}</strong><button type="button" data-change="${id}" data-delta="1" aria-label="Tambah ${catalog[id].name}">+</button></div></div>`).join("");
      }
      const total=entries.reduce((sum,[id,qty])=>sum+catalog[id].price*qty,0);
      document.getElementById("cartTotal").textContent=money(total);
      document.getElementById("orderResult").hidden=true;
    }
    function openCart(){updateCart();modal.classList.add("open");document.body.style.overflow="hidden";}
    function closeCart(){modal.classList.remove("open");document.body.style.overflow="";}
    document.querySelectorAll("[data-add]").forEach(button=>button.addEventListener("click",()=>addItem(button.dataset.add)));
    document.getElementById("openCart").addEventListener("click",openCart);
    document.getElementById("ctaOrder").addEventListener("click",openCart);
    document.getElementById("closeCart").addEventListener("click",closeCart);
    modal.addEventListener("click",e=>{if(e.target===modal)closeCart();});
    document.addEventListener("keydown",e=>{if(e.key==="Escape")closeCart();});
    document.getElementById("cartList").addEventListener("click",e=>{
      const button=e.target.closest("[data-change]");if(!button)return;
      const id=button.dataset.change;cart[id]=(cart[id]||0)+Number(button.dataset.delta);
      if(cart[id]<=0)delete cart[id];updateCart();
    });
    document.getElementById("demoForm").addEventListener("submit",e=>{
      e.preventDefault();
      const entries=Object.entries(cart).filter(([,qty])=>qty>0);
      if(!entries.length){showToast("Tambahkan minimal satu produk dahulu");return;}
      const name=document.getElementById("customerName").value.trim();
      const total=entries.reduce((sum,[id,qty])=>sum+catalog[id].price*qty,0);
      const lines=entries.map(([id,qty])=>`${catalog[id].name} × ${qty}`).join(" • ");
      const result=document.getElementById("orderResult");
      result.hidden=false;
      result.textContent=`SIMULASI BERHASIL — Nama: ${name}. Pesanan: ${lines}. Total contoh: ${money(total)}. Tidak ada pesanan yang dikirim dan tidak ada data yang disimpan.`;
      result.scrollIntoView({behavior:"smooth",block:"nearest"});
    });
    // Reveal animation, with reduced-motion preference respected in CSS.
    const observer=new IntersectionObserver(entries=>{
      entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add("visible");observer.unobserve(entry.target);}});
    },{threshold:.12});
    document.querySelectorAll(".reveal:not(.visible)").forEach(el=>observer.observe(el));
    updateCart();
  </script>
</body>
</html>
